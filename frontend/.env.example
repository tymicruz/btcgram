# Copy this to .env.local and fill in your own machine's LAN IP
# (run `ipconfig getifaddr en0` on Mac to find it), so your phone
# can reach the backend running on your computer over Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:8080

# From your Supabase project's dashboard: Project Settings -> API.
# Use the "anon" / "public" key here - never the "service_role" / secret
# key, which bypasses all Row Level Security and must never ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# From Google Cloud Console (APIs & Services -> Credentials). You need both
# a "Web application" and an "iOS" OAuth client ID - register both (Web
# first) as comma-separated values in Supabase's Google provider settings.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<your-ios-client-id>.apps.googleusercontent.com
